include LICENSE NOTICE.md README.md CHANGELOG.md SECURITY.md CONTRIBUTING.md PUBLIC_FILES.txt
include requirements.txt requirements-dev.txt cf_platform.py
recursive-include docs *.md
recursive-include examples followers.example.csv
recursive-include scripts *.py *.ps1
recursive-include tests *.py
recursive-exclude * __pycache__ *.py[cod] .DS_Store
prune .git
prune .venv
prune .local
prune .cache
prune chrome-profile
prune data
prune dist
prune build
exclude .env
exclude followers.csv
exclude close_friends_progress.csv
exclude close_friends_status.csv
exclude close_friends_pending.csv
